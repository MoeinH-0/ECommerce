@using _0_Framework.Application
@using _0_Framework.Infrastructure
@model _01_ShopQuery.MenuModel
@inject IAuthHelper AuthHelper

<style>
    .navigation-menu-wrapper nav > ul > li {
        margin: 0 8px !important;
    }
    
    .navigation-menu-wrapper nav > ul > li > a {
        font-size: 14px !important;
        padding: 10px 5px !important;
    }
    
    .auth-link-custom {
        font-weight: bold !important;
        color: #d33 !important;
    }
    
    .mini-cart {
        right: auto !important;
        left: 0 !important;
        top: 100% !important;
        transform: none !important;
    }
    
    .header-cart-icon {
        position: relative !important;
    }
    
    .header-icon-wrapper .icon-list > li {
        position: relative !important;
    }
</style>


<div class="header-area header-sticky">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="header-wrapper d-none d-lg-flex">
                    <div class="logo">
                        <a asp-page="/Index">
                            <img src="~/Theme/assets/img/logo.png" class="img-fluid" alt="">
                        </a>
                    </div>
                    
                    <div class="navigation-menu-wrapper">
                        <nav>
                            <ul>
                                <li>
                                    <a asp-page="/Index">صفحه اصلی</a>
                                </li>
                                <li class="menu-item-has-children">
                                    <a>محصولات</a>
                                    <ul class="sub-menu">
                                        @foreach (var category in Model.ProductCategories)
                                        {
                                            <li>
                                                <a asp-page="./ProductCategory"
                                                   asp-route-id="@category.Slug">@category.Name</a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                                <li class="menu-item-has-children">
                                    <a>مقالات</a>
                                    <ul class="sub-menu">
                                        @foreach (var category in Model.ArticleCategories)
                                        {
                                            <li>
                                                <a asp-page="./ArticleCategory"
                                                   asp-route-id="@category.Slug">@category.Name</a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                                @* <li> *@
                                @*     <a asp-page="/Contact">تماس با ما</a> *@
                                @* </li> *@

                                @if (AuthHelper.IsAuthenticated())
                                {
                                    @if (AuthHelper.HasAccessToAdminPanel())
                                    {
                                        <li>
                                            
                                            <a href="/Administration">پنل مدیریت</a>
                                        </li>
                                    }
                                    <li>
                                        <a asp-page="/Account" asp-page-handler="Logout" class="auth-link-custom">خروج</a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a asp-page="/Account" class="auth-link-custom" style="color: #333 !important;">ورود / ثبت نام</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                    
                    <div class="header-icon-wrapper">
                        <ul class="icon-list">
                            <li>
                                <a href="javascript:void(0)" id="search-overlay-trigger">
                                    <i class="ion-ios-search-strong"></i>
                                </a>
                            </li>
                            <li>
                                <div class="header-cart-icon">
                                    <a href="#" id="minicart-trigger">
                                        <i class="ion-bag"></i>
                                        <span class="counter" id="cart_items_count">0</span>
                                    </a>
                                    <div class="mini-cart" id="mini-cart">
                                        <div class="cart-items-wrapper ps-scroll" id="cart_items_wrapper">
                                        </div>
                                        <div class="cart-buttons">
                                            <a asp-page="/Cart">مشاهده سبد خرید</a>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="header-mobile-navigation d-block d-lg-none">
                    <div class="row align-items-center">
                        <div class="col-6 col-md-6">
                            <div class="header-logo">
                                <a asp-page="/Index">
                                    <img src="~/Theme/assets/img/logo.png" class="img-fluid" alt="">
                                </a>
                            </div>
                        </div>
                        <div class="col-6 col-md-6">
                            <div class="mobile-navigation text-right">
                                <div class="header-icon-wrapper">
                                    <ul class="icon-list justify-content-end">
                                        <li>
                                            <div class="header-cart-icon">
                                                <a asp-page="/Cart">
                                                    <i class="ion-bag"></i>
                                                    <span class="counter">0</span>
                                                </a>
                                            </div>
                                        </li>
                                        <li>
                                            <a href="javascript:void(0)" class="mobile-menu-icon"
                                               id="mobile-menu-trigger">
                                                <i class="fa fa-bars"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="offcanvas-mobile-menu" id="offcanvas-mobile-menu">
    <a href="javascript:void(0)" class="offcanvas-menu-close" id="offcanvas-menu-close-trigger">
        <i class="ion-android-close"></i>
    </a>

    <div class="offcanvas-wrapper">
        <div class="offcanvas-inner-content">
            <div class="offcanvas-mobile-search-area">
                <form action="#">
                    <input type="search" placeholder="جستجو ...">
                    <button type="submit">
                        <i class="fa fa-search"></i>
                    </button>
                </form>
            </div>
            <nav class="offcanvas-navigation">
                <ul>
                    <li>
                        <a asp-page="/Index">صفحه اصلی</a>
                    </li>
                    <li class="menu-item-has-children">
                        <a href="#">محصولات</a>
                        <ul class="sub-menu">
                            @foreach (var category in Model.ProductCategories)
                            {
                                <li>
                                    <a asp-page="./ProductCategory"
                                       asp-route-id="@category.Slug">@category.Name</a>
                                </li>
                            }
                        </ul>
                    </li>

                    <li class="menu-item-has-children">
                        <a href="#">مقالات</a>
                        <ul class="sub-menu">
                            @foreach (var category in Model.ArticleCategories)
                            {
                                <li>
                                    <a asp-page="./ArticleCategory"
                                       asp-route-id="@category.Slug">@category.Name</a>
                                </li>
                            }
                        </ul>
                    </li>
                    <li>
                        <a asp-page="/Contact">تماس با ما</a>
                    </li>
                    
                    @if (AuthHelper.IsAuthenticated())
                    {
                        @if (AuthHelper.HasAccessToAdminPanel())
                        {
                            <li>
                                <a href="/Administration">پنل مدیریت</a>
                            </li>
                        }
                        <li>
                            <a asp-page="/Account" asp-page-handler="Logout">خروج</a>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a asp-page="/Account">ورود / ثبت نام</a>
                        </li>
                    }
                </ul>
            </nav>

            <div class="offcanvas-widget-area">
                <div class="off-canvas-contact-widget">
                    <div class="header-contact-info">
                        <ul class="header-contact-info__list">
                            <li>
                                <i class="ion-android-phone-portrait"></i>
                                <a href="tel://12452456012">
                                    (1245) 2456 012
                                </a>
                            </li>
                            <li>
                                <i class="ion-android-mail"></i> 
                                <a href="mailto:info@yourdomain.com">info@atriya.com</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
