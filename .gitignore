#############################################
# .NET / ASP.NET Core (Clean Architecture)
#############################################

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
*.log

# Published output
**/[Pp]ublish/
**/[Pp]ublished/
*.Publish.xml

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
# (optional) if you use local packages folder:
# packages/

# Test results / coverage
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*/
coveragereport*/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

#############################################
# Visual Studio / VS Code / Rider / IntelliJ
#############################################

.vs/
.idea/
*.iml
*.ipr
*.iws

.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio cache / temp
*.cache
*.tlog
*.pdb
*.opendb
*.VC.db
*.VC.VC.opendb

#############################################
# .NET build artifacts you mentioned
#############################################

*.dll
*.exe
*.pdb
*.mdb

# Cache (typo-safe)
*.cache

#############################################
# ASP.NET Core secrets / environment
#############################################

# App settings overrides (keep templates tracked if you have them)
appsettings.Development.json
appsettings.Local.json

# Generic env files
.env
.env.*
secrets.json

#############################################
# OS generated
#############################################

.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

#############################################
# Node / Frontend (if any)
#############################################

node_modules/
.cache/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

#############################################
# wwwroot handling
#############################################

**/wwwroot/ProductPictures/
**/wwwroot/.idea/


#############################################
# Misc
#############################################

# Backup / temp
*.bak
*.tmp
*.temp
*.swp
*~

# JetBrains Rider specific
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/contentModel.xml
.idea/**/modules.xml
.idea/**/.name
.idea/**/dataSources/
